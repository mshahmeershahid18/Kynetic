# ---------------------------------------------------------------------------
# Next.js app
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (public)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase (server only — never expose to the browser)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Python FastAPI AI service
AI_SERVICE_URL=http://localhost:8000

# Transactional email (Gmail app password, server side only)
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Optional landing page contact form
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=


# ---------------------------------------------------------------------------
# services/ai — set these on the Python service, not on Vercel
# ---------------------------------------------------------------------------

# Google Gemini. Without a key the service falls back to the deterministic
# engine and still returns valid plans and feedback.
# GEMINI_API_KEY=your-gemini-api-key
# GEMINI_MODEL=gemini-flash-latest
# GEMINI_TIMEOUT_SECONDS=30

# Supabase JWT verification. Copy from Supabase → Settings → API → JWT Secret.
# Required in production: without it the AI endpoints are unauthenticated.
# SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# Set to false ONLY for local development without Supabase. Defaults to true
# whenever SUPABASE_JWT_SECRET is present.
# REQUIRE_AUTH=true

# Comma-separated origins allowed to call the service directly.
# ALLOWED_ORIGINS=https://your-app.vercel.app
