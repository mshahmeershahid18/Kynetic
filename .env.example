# Next.js app URL used for Supabase OAuth and email redirects
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Next.js public Supabase values
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server-only values for later phases
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Separate Python FastAPI AI service
AI_SERVICE_URL=http://localhost:8000

# Optional landing/contact integrations for later phases
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=

# Transactional email for later phases
GMAIL_USER=
GMAIL_APP_PASSWORD=
